{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guardrails/git-discipline-gate.mjs\"", "timeout": 5 }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guardrails/skill-preflight-gate.mjs\"", "timeout": 5 },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guardrails/protected-paths-block.mjs\"", "timeout": 5 },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guardrails/prebuild-ui-reuse-gate.mjs\"", "timeout": 5 },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guardrails/client-isolation-guard.mjs\"", "timeout": 5 },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guardrails/deliverable-text-gate.mjs\"", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guardrails/skill-usage-track.mjs\"", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guardrails/session-close-guard.mjs\"", "timeout": 8 }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guardrails/session-close-guard.mjs\"", "timeout": 8 }
        ]
      }
    ]
  }
}
